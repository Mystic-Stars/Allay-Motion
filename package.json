{
  "name": "allay-motion",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @allay/desktop dev",
    "website:dev": "pnpm --filter @allay/website dev",
    "website:build": "pnpm --filter @allay/website build",
    "website:preview": "pnpm --filter @allay/website preview",
    "website:mc": "tsx scripts/extract-website-mc.ts",
    "build": "pnpm templates:build && pnpm --filter @allay/desktop build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && node --test tests/sync-gitcode-release.test.mjs tests/pull-github-release-assets.test.mjs",
    "test:engine": "vite build --configLoader runner --config tests/engine/vite.config.ts && playwright test --config playwright.engine.config.ts",
    "test:engine:templates": "vite build --configLoader runner --config tests/engine/vite.config.ts && playwright test --config playwright.engine.config.ts tests/engine/templates.spec.ts",
    "test:export": "vitest run --config vitest.export.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:website": "pnpm --filter @allay/website build && playwright test --config playwright.website.config.ts",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:removable": "tsx scripts/check-removable.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:engine && pnpm test:export && pnpm check:provenance && pnpm check:licenses && pnpm test:website && pnpm test:e2e",
    "assets:gen": "tsx scripts/not-implemented.ts assets:gen M2",
    "templates:build": "tsx scripts/build-templates.ts",
    "templates:baselines": "tsx scripts/gen-template-baselines.ts",
    "templates:api": "tsx scripts/gen-template-api.ts",
    "mascot:bake": "tsx scripts/mascot-bake.ts",
    "ffmpeg:fetch": "tsx scripts/fetch-ffmpeg.ts",
    "licenses:gen": "tsx scripts/third-party.ts",
    "dist": "tsx scripts/ensure-electron-dist.ts && pnpm templates:build && tsx scripts/mascot-dist.ts && tsx scripts/dist-extras.ts && pnpm --filter @allay/desktop dist && vitest run --config vitest.dist.config.ts",
    "review:m1": "tsx scripts/review-m1.ts",
    "review:m2b": "tsx scripts/review-m2b.ts",
    "review:m3": "tsx scripts/review-m3.ts",
    "review:m4": "tsx scripts/review-m4.ts",
    "review:ui-redesign": "tsx scripts/review-ui-redesign.ts",
    "review:md-b": "tsx scripts/review-md-b.ts",
    "review:m5b": "tsx scripts/review-m5b.ts",
    "review:m8": "tsx scripts/review-m8.ts",
    "review:ux-wave": "tsx scripts/review-ux-wave.ts",
    "review:templates": "tsx scripts/review-templates.ts",
    "review:gallery": "tsx scripts/review-gallery.ts",
    "test:e2e:baselines": "pnpm build && playwright test tests/e2e/m4.spec.ts -g T-UI-5 --update-snapshots"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/yauzl": "^3.4.0",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  }
}
