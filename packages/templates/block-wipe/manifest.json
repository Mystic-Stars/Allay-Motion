{
  "formatVersion": 1,
  "id": "allay.builtin.block-wipe",
  "version": "1.0.0",
  "name": { "zh-CN": "方块擦除", "en": "Block wipe" },
  "description": {
    "zh-CN": "方块按某种顺序一个个弹出来铺满画面，停留，再按某种顺序缩回去。",
    "en": "Blocks pop in one by one to fill the screen, hold, then shrink away."
  },
  "license": "MIT",
  "category": "transition",
  "tags": ["blocks", "wipe"],
  "groups": [
    { "key": "blocks", "label": { "zh-CN": "方块", "en": "Blocks" } },
    { "key": "motion", "label": { "zh-CN": "动画", "en": "Motion" } },
    { "key": "timing", "label": { "zh-CN": "时间", "en": "Timing" } },
    { "key": "sound", "label": { "zh-CN": "音效", "en": "Sound" }, "collapsed": true }
  ],
  "params": [
    {
      "key": "blocks",
      "type": "blockList",
      "label": { "zh-CN": "方块", "en": "Blocks" },
      "hint": { "zh-CN": "拖动调整方块顺序；权重为 0 的方块不参与分布", "en": "Drag to reorder. Blocks with zero weight are skipped." },
      "group": "blocks",
      "default": [{ "id": "minecraft:diamond_block", "weight": 1 }],
      "max": 8
    },
    {
      "key": "materialDistribution",
      "type": "enum",
      "label": { "zh-CN": "材质分布", "en": "Material distribution" },
      "hint": { "zh-CN": "只改变格子的材质，不改变动画顺序。至少两种有效方块才看得出区别；有序布局按列表顺序，忽略非零权重大小。", "en": "Changes materials, not animation order. Use at least two distinct active blocks to see a difference. Ordered layouts use list order, not positive weight magnitudes." },
      "group": "blocks",
      "default": "weightedRandom",
      "options": [
        { "value": "weightedRandom", "label": { "zh-CN": "加权随机", "en": "Weighted random" } },
        { "value": "horizontalStripes", "label": { "zh-CN": "横条纹", "en": "Horizontal stripes" } },
        { "value": "verticalStripes", "label": { "zh-CN": "竖条纹", "en": "Vertical stripes" } },
        { "value": "cyclic", "label": { "zh-CN": "逐格循环", "en": "Cell cycle" } },
        { "value": "checker", "label": { "zh-CN": "棋盘格", "en": "Checker" } },
        { "value": "diagonal", "label": { "zh-CN": "斜条纹", "en": "Diagonal stripes" } }
      ]
    },
    { "key": "cols", "type": "integer", "label": { "zh-CN": "列数", "en": "Columns" }, "group": "blocks", "default": 12, "min": 4, "max": 40, "ui": "slider" },
    {
      "key": "style",
      "type": "enum",
      "label": { "zh-CN": "样式", "en": "Style" },
      "group": "blocks",
      "default": "3d",
      "options": [
        { "value": "flat", "label": { "zh-CN": "正交（无面明暗）", "en": "Orthographic (unshaded)" } },
        { "value": "3d", "label": { "zh-CN": "立体", "en": "3D" } }
      ]
    },
    {
      "key": "inPattern",
      "type": "enum",
      "label": { "zh-CN": "进入顺序", "en": "In pattern" },
      "group": "motion",
      "default": "centerOut",
      "ui": "pattern",
      "options": [
        { "value": "leftToRight", "label": { "zh-CN": "从左到右", "en": "Left to right" }, "pattern": [0, 0.33, 0.67, 1, 0, 0.33, 0.67, 1, 0, 0.33, 0.67, 1, 0, 0.33, 0.67, 1] },
        { "value": "rightToLeft", "label": { "zh-CN": "从右到左", "en": "Right to left" }, "pattern": [1, 0.67, 0.33, 0, 1, 0.67, 0.33, 0, 1, 0.67, 0.33, 0, 1, 0.67, 0.33, 0] },
        { "value": "topToBottom", "label": { "zh-CN": "从上到下", "en": "Top to bottom" }, "pattern": [0, 0, 0, 0, 0.33, 0.33, 0.33, 0.33, 0.67, 0.67, 0.67, 0.67, 1, 1, 1, 1] },
        { "value": "bottomToTop", "label": { "zh-CN": "从下到上", "en": "Bottom to top" }, "pattern": [1, 1, 1, 1, 0.67, 0.67, 0.67, 0.67, 0.33, 0.33, 0.33, 0.33, 0, 0, 0, 0] },
        { "value": "centerOut", "label": { "zh-CN": "中心扩散", "en": "Center out" }, "pattern": [1, 0.62, 0.62, 1, 0.62, 0, 0, 0.62, 0.62, 0, 0, 0.62, 1, 0.62, 0.62, 1] },
        { "value": "edgesIn", "label": { "zh-CN": "四周向内", "en": "Edges in" }, "pattern": [0, 0.38, 0.38, 0, 0.38, 1, 1, 0.38, 0.38, 1, 1, 0.38, 0, 0.38, 0.38, 0] },
        { "value": "diagonal", "label": { "zh-CN": "对角线", "en": "Diagonal" }, "pattern": [0, 0.17, 0.33, 0.5, 0.17, 0.33, 0.5, 0.67, 0.33, 0.5, 0.67, 0.83, 0.5, 0.67, 0.83, 1] },
        { "value": "random", "label": { "zh-CN": "随机", "en": "Random" }, "pattern": [0.47, 0.93, 0.13, 0.67, 0.27, 0.8, 0.53, 0.07, 0.87, 0.33, 1, 0.4, 0.6, 0.2, 0.73, 0] },
        { "value": "noise", "label": { "zh-CN": "噪声", "en": "Noise" }, "pattern": [0.53, 1, 0.72, 0.39, 0.68, 0.9, 0.45, 0, 0.22, 0.48, 0.46, 0.29, 0.07, 0.66, 0.95, 0.6] }
      ]
    },
    {
      "key": "outPattern",
      "type": "enum",
      "label": { "zh-CN": "退出顺序", "en": "Out pattern" },
      "group": "motion",
      "default": "reverse",
      "options": [
        { "value": "same", "label": { "zh-CN": "与进入相同", "en": "Same as in" } },
        { "value": "reverse", "label": { "zh-CN": "与进入相反", "en": "Reverse of in" } },
        { "value": "leftToRight", "label": { "zh-CN": "从左到右", "en": "Left to right" } },
        { "value": "rightToLeft", "label": { "zh-CN": "从右到左", "en": "Right to left" } },
        { "value": "topToBottom", "label": { "zh-CN": "从上到下", "en": "Top to bottom" } },
        { "value": "bottomToTop", "label": { "zh-CN": "从下到上", "en": "Bottom to top" } },
        { "value": "centerOut", "label": { "zh-CN": "中心扩散", "en": "Center out" } },
        { "value": "edgesIn", "label": { "zh-CN": "四周向内", "en": "Edges in" } },
        { "value": "diagonal", "label": { "zh-CN": "对角线", "en": "Diagonal" } },
        { "value": "random", "label": { "zh-CN": "随机", "en": "Random" } },
        { "value": "noise", "label": { "zh-CN": "噪声", "en": "Noise" } }
      ]
    },
    { "key": "inDuration", "type": "duration", "label": { "zh-CN": "进入", "en": "In" }, "group": "timing", "default": 0.5, "min": 0.15, "max": 2 },
    { "key": "hold", "type": "duration", "label": { "zh-CN": "停留", "en": "Hold" }, "group": "timing", "default": 0.1, "min": 0, "max": 2 },
    { "key": "outDuration", "type": "duration", "label": { "zh-CN": "退出", "en": "Out" }, "group": "timing", "default": 0.5, "min": 0.15, "max": 2 },
    {
      "key": "overlap",
      "type": "number",
      "label": { "zh-CN": "重叠", "en": "Overlap" },
      "hint": { "zh-CN": "单个方块的动画占整个阶段的比例。设为 1 时所有方块同时动作，不再错开。", "en": "Share of the phase each block spends animating. At 1, all blocks move together without staggering." },
      "group": "motion",
      "default": 0.45,
      "min": 0.1,
      "max": 1,
      "step": 0.01,
      "ui": "slider"
    },
    { "key": "easing", "type": "easing", "label": { "zh-CN": "缓动", "en": "Easing" }, "group": "motion", "default": "backOut" },
    {
      "key": "spin",
      "type": "enum",
      "label": { "zh-CN": "翻转", "en": "Spin" },
      "group": "motion",
      "default": "flipY",
      "options": [
        { "value": "none", "label": { "zh-CN": "无", "en": "None" } },
        { "value": "flipX", "label": { "zh-CN": "横轴翻转", "en": "Flip X" } },
        { "value": "flipY", "label": { "zh-CN": "竖轴翻转", "en": "Flip Y" } },
        { "value": "twist", "label": { "zh-CN": "扭转", "en": "Twist" } }
      ]
    },
    { "key": "jitter", "type": "number", "label": { "zh-CN": "随机错落", "en": "Jitter" }, "group": "motion", "default": 0.1, "min": 0, "max": 0.5, "step": 0.01, "ui": "slider" },
    { "key": "placeSound", "type": "sound", "label": { "zh-CN": "放置音效", "en": "Place sound" }, "group": "sound", "default": "minecraft:block.stone.place" },
    { "key": "breakSound", "type": "sound", "label": { "zh-CN": "破坏音效", "en": "Break sound" }, "group": "sound", "default": "minecraft:block.stone.break" },
    { "key": "volume", "type": "number", "label": { "zh-CN": "音量", "en": "Volume" }, "group": "sound", "default": 0.6, "min": 0, "max": 1, "step": 0.01, "ui": "slider" },
    { "key": "spatialAudio", "type": "boolean", "label": { "zh-CN": "空间音效", "en": "Spatial sound" }, "group": "sound", "default": false },
    { "key": "music", "type": "sound", "label": { "zh-CN": "背景音乐", "en": "Background music" }, "group": "sound", "default": null },
    { "key": "musicVolume", "type": "number", "label": { "zh-CN": "音乐音量", "en": "Music volume" }, "group": "sound", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "ui": "slider", "visibleWhen": { "key": "music", "not": null } },
    { "key": "seed", "type": "seed", "label": { "zh-CN": "随机种子", "en": "Seed" }, "group": "motion", "default": 1 }
  ],
  "timeline": {
    "segments": [
      { "param": "inDuration", "label": { "zh-CN": "进入", "en": "In" } },
      { "param": "hold", "label": { "zh-CN": "停留", "en": "Hold" } },
      { "param": "outDuration", "label": { "zh-CN": "退出", "en": "Out" } }
    ]
  },
  "defaultOutput": { "width": 1920, "height": 1080, "fps": 60 }
}
